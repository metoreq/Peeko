{
  "name": "peeko",
  "version": "0.0.1",
  "description": "Peeko 0.0.1 Prerelease",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:user": "electron-builder --config.win.requestedExecutionLevel=asInvoker"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.5.0"
  },
  "build": {
    "appId": "com.metoreq.peeko",
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "skins",
        "to": "skins"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "productName": "Peeko",
    "copyright": "Copyright (c) 2026 Metoreq",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Peeko",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "author": "Metoreq",
  "license": "MIT",
  "keywords": [
    "overlay",
    "desktop",
    "animated",
    "wallpaper",
    "electron",
    "windows"
  ]
}
